# Database Connection (PostgreSQL / Neon)
DATABASE_URL=

# Server Port (Local dev default: 3001; Vercel sets its own)
PORT=3001

# Authentication & Encryption (Encryption key must be exactly 32 chars for AES-256)
JWT_SECRET=
ENCRYPTION_KEY=

# Application Public URLs (Configurable per environment, no trailing slashes)
# APP_URL: Public URL of the frontend (e.g., https://<your-project>.vercel.app or https://app.tripgain.com)
APP_URL=

# TRACKING_BASE_URL: Public base URL for email open pixel & click redirect tracking
# For initial Vercel phase: https://<your-project>.vercel.app/api/backend
# Later for custom domain: https://track.tripgain.com
TRACKING_BASE_URL=

# Frontend API URL (Configured in Vercel environment variables or frontend/.env)
# For Vercel production: /api/backend
# For local dev: http://localhost:3001
NEXT_PUBLIC_API_URL=/api/backend

# Scheduler / Cron Security Secret
# Used to authenticate external cron service calls to:
# GET or POST https://<your-project>.vercel.app/api/backend/api/scheduler/tick
# Header: "Authorization: Bearer <CRON_SECRET>" or "x-cron-secret: <CRON_SECRET>"
CRON_SECRET=

# AI Features (Google Gemini API - Optional)
GEMINI_API_KEY=

# Fallback Redirection for untracked/invalid links
DEFAULT_FALLBACK_URL=https://neo.tripgain.com/register-your-sme

# Mailbox OAuth Integrations (Optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
